string standalone.create_project(String arguments)
{
try 
{
	if(arguments == null || arguments.trim() == "")
	{
		result = Map();
		result.put("success",false);
		result.put("message","Missing arguments.");
		return result.toString();
	}

	args = arguments.toMap();
	dealId = ifnull(args.get("deal_id"),"");
	quoteId = ifnull(args.get("quote_id"),"");
	selectedSONumber = ifnull(args.get("sales_order_number"),"");
	checkTasksOnly = false;
	applyHoursOnly = false;
	checkArg = args.get("check_tasks_only");
	if(checkArg == true || checkArg == "true" || checkArg == "1")
	{
		checkTasksOnly = true;
	}
	applyArg = args.get("apply_hours_only");
	if(applyArg == true || applyArg == "true" || applyArg == "1")
	{
		applyHoursOnly = true;
	}

	fieldValuesArg = args.get("field_values");
	if(fieldValuesArg == null)
	{
		fieldValuesArg = Map();
	}

	portalId = "724354547";
	// Conference and Collaboration copies ~26 tasks. Wait for most of them so hours are not stamped on a partial copy.
	templateTaskReadyCount = 20;
	projectTemplateId = "1684307000012655127";
	projectLayoutId = "1684307000004725041";
	kickoffStatusId = "1684307000007196436";
	ungroupedProjectGroupId = "1684307000000018001";

	// Josh Van Wagenen in Zoho Projects.
	joshZpuid = "1684307000015406166";
	joshZuid = "903101142";
	joshEmail = "joshv@goclearvista.com";

	if(checkTasksOnly)
	{
		projectId = ifnull(args.get("project_id"),"");
		if(projectId == "")
		{
			result = Map();
			result.put("success",false);
			result.put("message","Missing Project ID.");
			return result.toString();
		}
		copiedTasks = List();
		try
		{
			taskResponse = invokeurl
			[
				url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/projects/" + projectId + "/tasks?per_page=200"
				type :GET
				connection:"zohoprojects"
			];
			if(taskResponse != null && taskResponse.get("tasks") != null)
			{
				copiedTasks = taskResponse.get("tasks");
			}
		}
		catch(taskPollErr)
		{
			copiedTasks = List();
		}
		taskCount = copiedTasks.size();
		hoursReady = false;
		if(taskCount >= templateTaskReadyCount)
		{
			hoursReady = true;
		}
		result = Map();
		result.put("success",true);
		result.put("hours_pending",!hoursReady);
		result.put("hours_ready",hoursReady);
		result.put("hours_applied",false);
		result.put("task_count",taskCount);
		result.put("ready_count",templateTaskReadyCount);
		result.put("project_id",projectId);
		return result.toString();
	}

	if(dealId == "")
	{
		result = Map();
		result.put("success",false);
		result.put("message","Missing Deal ID.");
		return result.toString();
	}

	if(quoteId == "")
	{
		result = Map();
		result.put("success",false);
		result.put("message","Missing selected Sales Quote.");
		return result.toString();
	}

	if(selectedSONumber == "")
	{
		result = Map();
		result.put("success",false);
		result.put("message","Missing Sales Order Number.");
		return result.toString();
	}

	deal = zoho.crm.getRecordById("Deals",dealId);

	if(deal == null || deal.isEmpty())
	{
		result = Map();
		result.put("success",false);
		result.put("message","Could not load the Deal.");
		return result.toString();
	}

	quote = zoho.crm.getRecordById("Quotes",quoteId);

	if(quote == null || quote.isEmpty())
	{
		result = Map();
		result.put("success",false);
		result.put("message","Could not load the selected Sales Quote.");
		return result.toString();
	}

	quoteSONumber = ifnull(quote.get("Sales_Order_Number"),"");

	if(quoteSONumber == "")
	{
		result = Map();
		result.put("success",false);
		result.put("message","The selected Sales Quote does not have a Sales Order Number.");
		return result.toString();
	}

	if(quoteSONumber != selectedSONumber)
	{
		result = Map();
		result.put("success",false);
		result.put("message","The selected SO Number no longer matches the Sales Quote. Recheck the Deal and try again.");
		return result.toString();
	}

	crmQuoteNumber = ifnull(quote.get("CRM_Quote_Number"),"");
	quoteNumber = ifnull(quote.get("Quote_Number"),"");
	if(crmQuoteNumber == "")
	{
		crmQuoteNumber = quoteNumber;
	}

	quoteDeal = quote.get("Deal_Name");

	if(quoteDeal != null)
	{
		if(quoteDeal.get("id") != null)
		{
			if(quoteDeal.get("id").toString() != dealId.toString())
			{
				result = Map();
				result.put("success",false);
				result.put("message","The selected Sales Quote is not related to this Deal.");
				return result.toString();
			}
		}
	}

	dealName = ifnull(deal.get("Deal_Name"),"");
	dealType = ifnull(deal.get("Deal_Type"),"");
	contactLookup = deal.get("Contact_Name");
	amountRaw = ifnull(deal.get("Amount"),"");

	descriptionOfWork = ifnull(
		fieldValuesArg.get("Description"),
		ifnull(deal.get("Description"),"")
	);

	internalWork = ifnull(
		fieldValuesArg.get("Description_of_Work_2"),
		ifnull(deal.get("Description_of_Work_2"),"")
	);

	slaLevel = ifnull(
		fieldValuesArg.get("SLA_Level"),
		ifnull(deal.get("SLA_Level"),"")
	);

	billingTerms = ifnull(
		fieldValuesArg.get("Payment_Schedule"),
		ifnull(deal.get("Payment_Schedule"),"")
	);

	billingException = ifnull(
		fieldValuesArg.get("Billing_Exception"),
		ifnull(deal.get("Billing_Exception"),"")
	);

	buildingName = ifnull(
		fieldValuesArg.get("Building_Name"),
		ifnull(deal.get("Building_Name"),"")
	);

	roomName = ifnull(
		fieldValuesArg.get("Room_Name"),
		ifnull(deal.get("Room_Name"),"")
	);

	address1 = ifnull(
		fieldValuesArg.get("Work_Site_Address"),
		ifnull(deal.get("Work_Site_Address"),"")
	);

	address2 = ifnull(
		fieldValuesArg.get("Work_Site_Address_2"),
		ifnull(deal.get("Work_Site_Address_2"),"")
	);

	city = ifnull(
		fieldValuesArg.get("Work_Site_City"),
		ifnull(deal.get("Work_Site_City"),"")
	);

	stateSelection = ifnull(
		fieldValuesArg.get("D_State_Selection"),
		ifnull(deal.get("D_State_Selection"),"")
	);

	zip = ifnull(
		fieldValuesArg.get("Work_City_Zip_Code"),
		ifnull(deal.get("Work_City_Zip_Code"),"")
	);

	installHoursRaw = ifnull(
		fieldValuesArg.get("Installation_Hours"),
		ifnull(deal.get("Installation_Hours"),"")
	);

	programmingHoursRaw = ifnull(
		fieldValuesArg.get("Programming_Hours"),
		ifnull(deal.get("Programming_Hours"),"")
	);

	scheduleExpectation = ifnull(
		fieldValuesArg.get("Schedule_Expectation"),
		ifnull(deal.get("Schedule_Expectation"),"")
	);

	programmingRequiredRaw = ifnull(
		fieldValuesArg.get("Programming_Required"),
		ifnull(deal.get("Programming_Required"),false)
	);

	programmingInformation = ifnull(
		fieldValuesArg.get("Programming"),
		ifnull(deal.get("Programming"),"")
	);

	powerElectrical = ifnull(
		fieldValuesArg.get("Power_Electrical"),
		ifnull(deal.get("Power_Electrical"),"")
	);

	preWireNeeded = ifnull(
		fieldValuesArg.get("Pre_Wire_Needed"),
		ifnull(deal.get("Pre_Wire_Needed"),"")
	);

	// Conditional Project-only date fields.
	preWireDate = ifnull(fieldValuesArg.get("pre_wire_date"),"");
	proposedStartDate = ifnull(fieldValuesArg.get("proposed_start_date"),"");
	lineDrawingInformation = ifnull(fieldValuesArg.get("sow_and_ld_information"),"");
	cadNeeded = fieldValuesArg.get("cad");
	if(cadNeeded == null)
	{
		cadNeeded = List();
	}
	if(!cadNeeded.contains("Signal Flow Diagrams"))
	{
		cadNeeded.add("Signal Flow Diagrams");
	}

	if(dealType != "Install Deal")
	{
		result = Map();
		result.put("success",false);
		result.put("message","This Deal Type is not Install Deal.");
		return result.toString();
	}

	if(applyHoursOnly)
	{
		projectId = ifnull(args.get("project_id"),"").toString();
		if(projectId == "")
		{
			result = Map();
			result.put("success",false);
			result.put("message","Missing Project ID.");
			return result.toString();
		}
		projectKey = ifnull(args.get("project_key"),"");
		projectName = ifnull(args.get("project_name"),"");
		headersMap = Map();
		headersMap.put("Content-Type","application/json");
	}
	else
	{
	missing = List();

	if(dealName == "")
	{
		missing.add("Deal Name");
	}

	if(contactLookup == null)
	{
		missing.add("Primary Contact");
	}

	if(internalWork == "")
	{
		missing.add("Technical Scope (INTERNAL)");
	}

	if(slaLevel == "")
	{
		missing.add("SLA Level");
	}

	programmingHoursForValidation = 0.0;
	try
	{
		programmingHoursForValidation = programmingHoursRaw.toDecimal();
	}
	catch(programmingValidationErr)
	{
		programmingHoursForValidation = 0.0;
	}

	if(programmingHoursForValidation > 0 && programmingInformation == "")
	{
		missing.add("Programming Information");
	}

	if(amountRaw == "")
	{
		missing.add("Project $ Amount");
	}

	if(billingTerms == "")
	{
		missing.add("Billing Terms");
	}

	if(buildingName == "")
	{
		missing.add("Building Name");
	}

	if(roomName == "")
	{
		missing.add("Room Name");
	}

	if(address1 == "")
	{
		missing.add("Work Site Address");
	}

	if(city == "")
	{
		missing.add("Work Site City");
	}

	if(stateSelection == "")
	{
		missing.add("Work Site State");
	}

	if(zip == "")
	{
		missing.add("Work Site Zip");
	}

	if(installHoursRaw == "")
	{
		missing.add("Installation Hours");
	}

	if(programmingHoursRaw == "")
	{
		missing.add("Programming Hours");
	}

	if(scheduleExpectation == "")
	{
		missing.add("Schedule Expectation");
	}

	if(preWireNeeded == "")
	{
		missing.add("Pre-Wire Required");
	}

	if(preWireNeeded != "" && preWireNeeded != "Yes" && preWireNeeded != "No")
	{
		missing.add("Pre-Wire Required must be Yes or No");
	}

	if(preWireNeeded == "Yes" && preWireDate == "")
	{
		missing.add("Pre-Wire Needed By Date");
	}

	if(scheduleExpectation == "By Deadline (date needed)" && proposedStartDate == "")
	{
		missing.add("Customer Install Deadline Date");
	}

	if(scheduleExpectation != "Next available" && scheduleExpectation != "By Deadline (date needed)")
	{
		missing.add("Schedule Expectation must be Next available or By Deadline (date needed)");
	}

	if(missing.size() > 0)
	{
		result = Map();
		result.put("success",false);
		result.put("message","Missing required fields: " + missing.toString());
		return result.toString();
	}

	// CRM and Projects use slightly different text for this corresponding value.
	if(billingTerms == "BILL:50-50 (Project timeline less than 30 days)")
	{
		billingTerms = "BILL:50-50 (Project timeline less than 30days)";
	}

	amount = 0.0;
	installHours = 0.0;
	programmingHours = 0.0;

	try
	{
		amount = amountRaw.toDecimal();
	}
	catch(amountErr)
	{
		amount = 0.0;
	}

	try
	{
		installHours = installHoursRaw.toDecimal();
	}
	catch(installErr)
	{
		installHours = 0.0;
	}

	try
	{
		programmingHours = programmingHoursRaw.toDecimal();
	}
	catch(programmingErr)
	{
		programmingHours = 0.0;
	}

	programmingRequired = false;

	if(programmingRequiredRaw == true)
	{
		programmingRequired = true;
	}
	else
	{
		programmingRequiredText = programmingRequiredRaw.toString().toLowerCase();

		if(
			programmingRequiredText == "true" ||
			programmingRequiredText == "yes"
		)
		{
			programmingRequired = true;
		}
	}

	// Programming hours always control the required flag, even if the widget is bypassed.
	if(programmingHours > 0)
	{
		programmingRequired = true;
	}

	// Resolve primary-contact values from the actual CRM Contact record.
	primaryContactName = "";
	primaryContactEmail = "";
	primaryContactPhone = "";

	if(contactLookup != null)
	{
		if(contactLookup.get("id") != null)
		{
			contact = zoho.crm.getRecordById(
				"Contacts",
				contactLookup.get("id")
			);

			if(contact != null && !contact.isEmpty())
			{
				primaryContactName = ifnull(contact.get("Full_Name"),"");
				primaryContactEmail = ifnull(contact.get("Email"),"");
				primaryContactPhone = ifnull(contact.get("Phone"),"");

				if(primaryContactPhone == "")
				{
					primaryContactPhone = ifnull(contact.get("Mobile"),"");
				}
			}
		}
	}

	if(primaryContactName == "" && contactLookup != null)
	{
		primaryContactName = ifnull(contactLookup.get("name"),"");
	}

	if(primaryContactEmail == "")
	{
		primaryContactEmail = "N/A";
	}

	if(primaryContactPhone == "")
	{
		primaryContactPhone = "N/A";
	}

	projectName = "SO - " + selectedSONumber + " " + dealName;

	projectParams = Map();
	projectParams.put("name",projectName);

	// Copy the full Project Template, including its task structure.
	projectParams.put("copy_from",projectTemplateId);

	projectParams.put("description",descriptionOfWork);
	projectParams.put(
		"start_date",
		zoho.currentdate.toString("yyyy-MM-dd")
	);
	projectParams.put("is_public_project",false);

	// Status: Kickoff.
	statusMap = Map();
	statusMap.put("id",kickoffStatusId);
	projectParams.put("status",statusMap);

	// Group: Ungrouped Projects.
	projectGroupMap = Map();
	projectGroupMap.put("id",ungroupedProjectGroupId);
	projectParams.put("project_group",projectGroupMap);

	// Layout: From Project Creation Form.
	layoutMap = Map();
	layoutMap.put("id",projectLayoutId);
	projectParams.put("layout",layoutMap);

	// CRM Deal association/integration field.
	projectParams.put("deal_id",dealId);

	// Project owner: Josh.
	ownerMap = Map();
	ownerMap.put("zpuid",joshZpuid);
	ownerMap.put("zuid",joshZuid);
	ownerMap.put("email",joshEmail);
	projectParams.put("owner",ownerMap);
	// Add existing portal users to this private Project. Josh is already the owner.
	projectUsers = List();

	userMap = Map();
	userMap.put("zpuid","1684307000015967041");
	userMap.put("zuid","910837433");
	userMap.put("email","ryanl@goclearvista.com");
	projectUsers.add(userMap);

	userMap = Map();
	userMap.put("zpuid","1684307000015310001");
	userMap.put("zuid","905259774");
	userMap.put("email","chrisi@goclearvista.com");
	projectUsers.add(userMap);

	userMap = Map();
	userMap.put("zpuid","1684307000000034619");
	userMap.put("zuid","724357594");
	userMap.put("email","daltonp@goclearvista.com");
	projectUsers.add(userMap);

	userMap = Map();
	userMap.put("zpuid","1684307000005450003");
	userMap.put("zuid","787400734");
	userMap.put("email","bubba@goclearvista.com");
	projectUsers.add(userMap);

	userMap = Map();
	userMap.put("zpuid","1684307000000083055");
	userMap.put("zuid","727058665");
	userMap.put("email","sethb@goclearvista.com");
	projectUsers.add(userMap);

	userMap = Map();
	userMap.put("zpuid","1684307000005505007");
	userMap.put("zuid","798753840");
	userMap.put("email","mindyb@goclearvista.com");
	projectUsers.add(userMap);

	userMap = Map();
	userMap.put("zpuid","1684307000000091786");
	userMap.put("zuid","727123878");
	userMap.put("email","spencere@goclearvista.com");
	projectUsers.add(userMap);

	projectParams.put("users",projectUsers);

	// Project custom fields.
	projectParams.put("project_amount",amount);
	projectParams.put("projects_cf_0005",descriptionOfWork);
	projectParams.put("description_of_work",internalWork);
	projectParams.put("sla_level",slaLevel);
	projectParams.put("billing_terms",billingTerms);
	projectParams.put("billing_exception",billingException);
	projectParams.put("building_name",buildingName);
	projectParams.put("room_name",roomName);
	projectParams.put("work_site_address",address1);
	projectParams.put("work_site_address_2",address2);
	projectParams.put("work_site_city",city);
	projectParams.put("work_site_state_selection",stateSelection);
	projectParams.put("work_site_zip",zip);
	projectParams.put("primary_contact_name",primaryContactName);
	projectParams.put("primary_contact_email",primaryContactEmail);
	projectParams.put("primary_contact_phone",primaryContactPhone);
	projectParams.put("schedule_expectation",scheduleExpectation);
	projectParams.put("pre_wire_needed",preWireNeeded);
	projectParams.put("programming_information",programmingInformation);
	projectParams.put("power_electrical",powerElectrical);
	projectParams.put("projects_cf_0003",installHours);
	projectParams.put("projects_cf_0004",programmingHours);
	projectParams.put("programming",programmingRequired);

	if(preWireNeeded == "Yes")
	{
		projectParams.put(
			"pre_wire_date",
			preWireDate
		);
	}

	if(scheduleExpectation == "By Deadline (date needed)")
	{
		projectParams.put(
			"proposed_start_date",
			proposedStartDate
		);
	}

	if(lineDrawingInformation != "")
	{
		projectParams.put(
			"sow_and_ld_information",
			lineDrawingInformation
		);
	}

	// CAD is a Projects multipicklist. Signal Flow Diagrams is always enforced.
	projectParams.put("cad",cadNeeded);

	headersMap = Map();
	headersMap.put("Content-Type","application/json");

	createResponse = invokeurl
	[
		url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/projects"
		type :POST
		body:projectParams.toString()
		headers:headersMap
		connection:"zohoprojects"
	];

	if(createResponse == null)
	{
		result = Map();
		result.put("success",false);
		result.put(
			"message",
			"Zoho Projects did not return a response. The project was not confirmed."
		);
		return result.toString();
	}

	if(createResponse.containsKey("error"))
	{
		errorMessage = "Zoho Projects returned an error.";
		errorObj = createResponse.get("error");

		if(errorObj != null)
		{
			if(errorObj.containsKey("details"))
			{
				detailsList = errorObj.get("details");

				if(detailsList != null && detailsList.size() > 0)
				{
					firstDetail = detailsList.get(0);

					if(firstDetail != null)
					{
						errorMessage = ifnull(
							firstDetail.get("message"),
							errorMessage
						);

						fieldName = ifnull(
							firstDetail.get("field_name"),
							""
						);

						if(fieldName != "")
						{
							errorMessage =
								errorMessage +
								" Field: " +
								fieldName;
						}
					}
				}
			}
			else if(errorObj.containsKey("title"))
			{
				errorMessage = ifnull(
					errorObj.get("title"),
					errorMessage
				);
			}
		}

		result = Map();
		result.put("success",false);
		result.put("message",errorMessage);
		return result.toString();
	}

	projectId = ifnull(createResponse.get("id"),"");
	projectKey = ifnull(createResponse.get("key"),"");

	if(projectId == "")
	{
		result = Map();
		result.put("success",false);
		result.put(
			"message",
			"Zoho Projects did not return a Project ID. The project was not confirmed."
		);
		return result.toString();
	}

	// Link the Project to the CRM Deal immediately after creation.
	assocData = Map();
	assocData.put("name",projectName);
	assocData.put("project_id",projectId);
	assocData.put("project_key",projectKey);

	assocList = List();
	assocList.add(assocData);

	assocWrapper = Map();
	assocWrapper.put("data",assocList);

	assocHeaders = Map();
	assocHeaders.put("Content-Type","application/json");

	assocResponse = invokeurl
	[
		url :"https://www.zohoapis.com/crm/v2/Deals/" + dealId + "/Zoho_Projects/" + projectId
		type :POST
		body:assocWrapper.toString()
		headers:assocHeaders
		connection:"zcrm"
	];

	if(assocResponse == null)
	{
		result = Map();
		result.put("success",false);
		result.put("message","Project was created, but CRM did not return a response when linking it to the Deal.");
		result.put("project_id",projectId);
		result.put("project_key",projectKey);
		result.put("project_name",projectName);
		return result.toString();
	}

	associationSuccessful = true;
	associationMessage = "";

	if(assocResponse.containsKey("code"))
	{
		assocCode = ifnull(assocResponse.get("code"),"");
		if(assocCode != "" && assocCode != "SUCCESS" && assocCode != "PROJECT_ASSOCIATED")
		{
			associationSuccessful = false;
			associationMessage = ifnull(assocResponse.get("message"),"Project was created, but CRM association failed.");
		}
	}

	if(assocResponse.containsKey("data"))
	{
		assocResponseData = assocResponse.get("data");
		if(assocResponseData != null && assocResponseData.size() > 0)
		{
			firstAssocResult = assocResponseData.get(0);
			assocStatus = ifnull(firstAssocResult.get("status"),"");
			assocResultCode = ifnull(firstAssocResult.get("code"),"");
			if(assocStatus != "success" && assocResultCode != "PROJECT_ASSOCIATED")
			{
				associationSuccessful = false;
				associationMessage = ifnull(firstAssocResult.get("message"),"Project was created, but CRM association failed.");
			}
		}
	}

	if(!associationSuccessful)
	{
		result = Map();
		result.put("success",false);
		result.put("message","Project was created, but CRM association failed: " + associationMessage);
		result.put("project_id",projectId);
		result.put("project_key",projectKey);
		result.put("project_name",projectName);
		return result.toString();
	}
	}

	warnings = List();
	pdfUploads = List();
	priceSheetId = "";
	priceSheetName = "";
	priceSheet = Map();
	priceSheetIdArg = ifnull(args.get("price_sheet_id"),"");
	tasksUpdated = 0;
	lineItemsCreated = 0;
	taskCount = 0;
	hoursPending = false;
	hoursApplied = false;
	hoursReady = false;
	workdriveFolderId = "";
	folderLookupError = "";
	folderRows = List();
	folderRow = Map();
	folderValText = "";
	foldersResp = Map();
	v3Docs = Map();
	v3DocsFolder = Map();
	docRows = List();
	docRow = Map();
	docName = "";
	documentsUrl = "https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + projectId + "/documents/";
	documentsListUrl = documentsUrl + "?range=100&category=all";
	if(applyHoursOnly)
	{
		try
		{
			v3Docs = invokeurl
			[
				url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/projects/" + projectId + "/documents"
				type :GET
				connection:"zohoprojects"
			];
			try
			{
				workdriveFolderId = ifnull(v3Docs.get("workdrive_folder_id"),"").toString();
			}
			catch(v3FolderTopErr)
			{
				workdriveFolderId = "";
			}
			if(workdriveFolderId == "")
			{
				v3DocsFolder = Map();
				try
				{
					v3DocsFolder = v3Docs.get("documents");
					workdriveFolderId = ifnull(v3DocsFolder.get("workdrive_folder_id"),"").toString();
				}
				catch(v3FolderDocsErr)
				{
				}
			}
			if(workdriveFolderId == "")
			{
				v3DocsFolder = Map();
				try
				{
					v3DocsFolder = v3Docs.get("data");
					workdriveFolderId = ifnull(v3DocsFolder.get("workdrive_folder_id"),"").toString();
				}
				catch(v3FolderDataErr)
				{
				}
			}
			if(workdriveFolderId == "crmworkspace" || workdriveFolderId == projectId)
			{
				workdriveFolderId = "";
			}
			if(workdriveFolderId == "")
			{
				try
				{
					folderLookupError = "v3 title=" + ifnull(v3Docs.get("title"),"").toString() + " error=" + ifnull(v3Docs.get("error"),"").toString();
				}
				catch(v3DumpErr)
				{
					folderLookupError = "v3 documents GET had no workdrive_folder_id";
				}
			}
		}
		catch(v3DocsErr)
		{
			folderLookupError = v3DocsErr.toString();
		}
		if(workdriveFolderId == "")
		{
		try
		{
			foldersResp = invokeurl
			[
				url :"https://projectsapi.zoho.com/restapi/portal/" + portalId + "/projects/" + projectId + "/folders/"
				type :GET
				connection:"zohoprojects"
			];
			try
			{
				if(foldersResp.get("folders") != null)
				{
					folderRows = foldersResp.get("folders");
				}
			}
			catch(foldersKeyErr)
			{
			}
			try
			{
				if(folderRows.size() <= 0 && foldersResp.get("dataobj") != null)
				{
					folderRows = foldersResp.get("dataobj");
				}
			}
			catch(foldersDataobjErr)
			{
			}
			for each folderRow in folderRows
			{
				if(workdriveFolderId == "")
				{
					folderValText = "";
					try
					{
						folderValText = ifnull(folderRow.get("res_id"),"").toString();
					}
					catch(folderResErr)
					{
						folderValText = "";
					}
					if(folderValText == "")
					{
						try
						{
							folderValText = ifnull(folderRow.get("id"),"").toString();
						}
						catch(folderIdErr)
						{
							folderValText = "";
						}
					}
					if(folderValText != "" && folderValText != "crmworkspace" && folderValText != projectId && folderValText.length() > 12 && folderValText.replaceAll("[^a-zA-Z]","") != "")
					{
						workdriveFolderId = folderValText;
					}
				}
			}
			if(workdriveFolderId == "")
			{
				try
				{
					folderLookupError = foldersResp.toString();
				}
				catch(folderDumpErr)
				{
					folderLookupError = "";
				}
				if(folderLookupError == "")
				{
					try
					{
						folderLookupError = "title=" + ifnull(foldersResp.get("title"),"").toString();
					}
					catch(folderTitleErr)
					{
					}
					try
					{
						folderLookupError = folderLookupError + " error=" + ifnull(foldersResp.get("error"),"").toString();
					}
					catch(folderErrorErr)
					{
					}
					try
					{
						folderLookupError = folderLookupError + " folders=" + foldersResp.get("folders").size().toString();
					}
					catch(folderSizeErr)
					{
					}
				}
				if(folderLookupError == "")
				{
					folderLookupError = "(empty folders response)";
				}
			}
		}
		catch(foldersRespErr)
		{
			folderLookupError = foldersRespErr.toString();
		}
		}
	}

	// PDF uploads and task-hour updates must never fail project creation.
	try
	{
		if(priceSheetIdArg != "")
		{
			try
			{
				argSheet = zoho.crm.getRecordById("Install_Price_Sheets",priceSheetIdArg);
				if(argSheet != null && argSheet.get("id") != null)
				{
					priceSheet = argSheet;
				}
			}
			catch(argSheetErr)
			{
				priceSheet = Map();
			}
		}

		sqTokens = List();
		if(crmQuoteNumber != "")
		{
			sqTokens.add(crmQuoteNumber.toString());
		}
		if(quoteNumber != "" && quoteNumber.toString() != crmQuoteNumber.toString())
		{
			sqTokens.add(quoteNumber.toString());
		}

		// Prefer the price sheet linked to this Sales Quote. Fall back to the Deal related list + SQ in the name.
		if(priceSheet.get("id") == null)
		{
			try
			{
				lookupSheets = zoho.crm.searchRecords("Install_Price_Sheets","(Sales_Quote_Lookup:equals:" + quoteId + ")");
				if(lookupSheets != null && lookupSheets.size() > 0 && lookupSheets.get(0) != null && lookupSheets.get(0).get("id") != null)
				{
					bestSheet = lookupSheets.get(0);
					bestTime = 0.0;
					bestTimeStamp = ifnull(bestSheet.get("Modified_Time"),ifnull(bestSheet.get("Created_Time"),"")).toString().replaceAll("[^0-9]","");
					if(bestTimeStamp != "")
					{
						try
						{
							bestTime = bestTimeStamp.toDecimal();
						}
						catch(bestTimeErr)
						{
							bestTime = 0.0;
						}
					}
					for each  sheet in lookupSheets
					{
						sheetTime = 0.0;
						sheetTimeStamp = ifnull(sheet.get("Modified_Time"),ifnull(sheet.get("Created_Time"),"")).toString().replaceAll("[^0-9]","");
						if(sheetTimeStamp != "")
						{
							try
							{
								sheetTime = sheetTimeStamp.toDecimal();
							}
							catch(sheetTimeErr)
							{
								sheetTime = 0.0;
							}
						}
						if(sheetTime > bestTime)
						{
							bestSheet = sheet;
							bestTime = sheetTime;
						}
					}
					priceSheet = bestSheet;
				}
			}
			catch(lookupErr)
			{
			}
		}

		if((priceSheet == null || priceSheet.get("id") == null))
		{
			relatedSheets = List();
			try
			{
				relatedSheets = zoho.crm.getRelatedRecords("Install_Price_Sheets","Deals",dealId,1,200);
			}
			catch(relatedErr)
			{
				relatedSheets = List();
			}

			if(relatedSheets != null && relatedSheets.size() > 0 && relatedSheets.get(0) != null && relatedSheets.get(0).get("id") != null)
			{
				bestSheet = Map();
				bestTime = 0.0;
				for each  sheet in relatedSheets
				{
					sheetName = ifnull(sheet.get("Name"),"").toString();
					nameLower = sheetName.toLowerCase();
					nameLooksLikePriceSheet = nameLower.contains("install price sheet");
					matchesSq = false;
					for each  token in sqTokens
					{
						if(token != "" && sheetName.contains(token))
						{
							matchesSq = true;
						}
					}
					if(nameLooksLikePriceSheet && (matchesSq || sqTokens.size() == 0))
					{
						sheetTime = 0.0;
						sheetTimeStamp = ifnull(sheet.get("Modified_Time"),ifnull(sheet.get("Created_Time"),"")).toString().replaceAll("[^0-9]","");
						if(sheetTimeStamp != "")
						{
							try
							{
								sheetTime = sheetTimeStamp.toDecimal();
							}
							catch(sheetTimeErr)
							{
								sheetTime = 0.0;
							}
						}
						if(bestSheet.get("id") == null || sheetTime > bestTime)
						{
							bestSheet = sheet;
							bestTime = sheetTime;
						}
					}
				}
				if(bestSheet.get("id") != null)
				{
					priceSheet = bestSheet;
				}
			}
		}

		if((priceSheet == null || priceSheet.get("id") == null) && sqTokens.size() > 0)
		{
			for each  token in sqTokens
			{
				nameCandidates = List();
				nameCandidates.add("Install Price Sheet - SQ " + token);
				nameCandidates.add("Install Price Sheet - SQ #" + token);
				nameCandidates.add("Install Price Sheet - " + token);
				for each  candidateName in nameCandidates
				{
					try
					{
						namedSheets = zoho.crm.searchRecords("Install_Price_Sheets","(Name:equals:" + candidateName + ")");
						if(namedSheets != null && namedSheets.size() > 0 && namedSheets.get(0) != null && namedSheets.get(0).get("id") != null)
						{
							priceSheet = namedSheets.get(0);
							break;
						}
					}
					catch(nameSearchErr)
					{
					}
				}
				if(priceSheet != null && priceSheet.get("id") != null)
				{
					break;
				}
			}
		}

		if(priceSheet != null && priceSheet.get("id") != null)
		{
			priceSheetId = priceSheet.get("id").toString();
			priceSheetName = ifnull(priceSheet.get("Name"),"");
			try
			{
				fullSheet = zoho.crm.getRecordById("Install_Price_Sheets",priceSheetId);
				if(fullSheet != null && fullSheet.get("id") != null)
				{
					priceSheet = fullSheet;
					priceSheetName = ifnull(priceSheet.get("Name"),priceSheetName);
				}
			}
			catch(fullSheetErr)
			{
			}

			if(applyHoursOnly)
			{
			try
			{
				attachments = zoho.crm.getRelatedRecords("Attachments","Install_Price_Sheets",priceSheetId,1,200);
				latestPdf = Map();
				latestPdfTime = 0.0;
				if(attachments != null && attachments.size() > 0 && attachments.get(0) != null && attachments.get(0).get("id") != null)
				{
					for each  attachment in attachments
					{
						fileName = ifnull(attachment.get("File_Name"),"").toString().toLowerCase();
						if(fileName.contains(".pdf"))
						{
							createdMillis = 0.0;
							createdStamp = ifnull(attachment.get("Created_Time"),ifnull(attachment.get("Modified_Time"),"")).toString().replaceAll("[^0-9]","");
							if(createdStamp != "")
							{
								try
								{
									createdMillis = createdStamp.toDecimal();
								}
								catch(pdfTimeErr)
								{
									createdMillis = 0.0;
								}
							}
							if(latestPdf.get("id") == null || createdMillis > latestPdfTime)
							{
								latestPdf = attachment;
								latestPdfTime = createdMillis;
							}
						}
					}
				}

				if(latestPdf.get("id") != null)
				{
					uploadName = priceSheetName;
					if(uploadName == "")
					{
						uploadName = "Install Price Sheet - SQ " + crmQuoteNumber;
					}
					pdfFileName = uploadName + ".pdf";
					pdfNeedle = uploadName.toLowerCase();
					pdfFileNeedle = pdfFileName.toLowerCase();
					pdfUploaded = false;
					pdfUploadError = "";
					docsGet = Map();
					docsGetRetry = Map();
					docRows = List();
					docRow = Map();
					docName = "";
					postRow = Map();
					legacyResponse = Map();
					try
					{
						pdfFile = invokeurl
						[
							url :"https://www.zohoapis.com/crm/v2/Install_Price_Sheets/" + priceSheetId + "/Attachments/" + latestPdf.get("id")
							type :GET
							connection:"zcrm"
						];
						pdfFile.setFileName(pdfFileName);
						pdfFile.setParamName("uploaddoc");
						legacyResponse = invokeurl
						[
							url :documentsUrl
							type :POST
							files:pdfFile
							connection:"zohoprojects"
						];
						pdfUploadError = "Documents POST returned empty.";
						try
						{
							postRow = legacyResponse.get(0);
						}
						catch(postListErr)
						{
							postRow = Map();
						}
						try
						{
							pdfUploadError = "POST name=" + ifnull(postRow.get("name"),"").toString() + " id=" + ifnull(postRow.get("id"),"").toString();
						}
						catch(postNameErr)
						{
							try
							{
								if(legacyResponse.toString() != "")
								{
									pdfUploadError = legacyResponse.toString();
								}
							}
							catch(postDumpErr)
							{
							}
						}
					}
					catch(priceSheetLegacyErr)
					{
						pdfUploadError = priceSheetLegacyErr.toString();
					}
					try
					{
						docsGet = invokeurl
						[
							url :documentsListUrl
							type :GET
							connection:"zohoprojects"
						];
						docRows = List();
						try
						{
							if(docsGet.get("dataobj") != null)
							{
								docRows = docsGet.get("dataobj");
							}
						}
						catch(docsDataobjErr)
						{
						}
						for each docRow in docRows
						{
							docName = "";
							try
							{
								docName = ifnull(docRow.get("res_name"),"").toString();
							}
							catch(docResErr)
							{
							}
							if(docName == "")
							{
								try
								{
									docName = ifnull(docRow.get("name"),"").toString();
								}
								catch(docNameErr)
								{
								}
							}
							if(docName.toLowerCase().contains(pdfFileNeedle) || (pdfNeedle != "" && docName.toLowerCase().contains(pdfNeedle)))
							{
								pdfUploaded = true;
							}
						}
						if(!pdfUploaded)
						{
							pdfUploadError = pdfUploadError + " GET names=";
							for each docRow in docRows
							{
								try
								{
									pdfUploadError = pdfUploadError + ifnull(docRow.get("res_name"),"").toString() + ",";
								}
								catch(docDumpErr)
								{
								}
							}
							try
							{
								pdfUploadError = pdfUploadError + " title=" + ifnull(docsGet.get("title"),"").toString();
							}
							catch(docsTitleErr)
							{
							}
						}
					}
					catch(docsGetErr)
					{
						pdfUploadError = pdfUploadError + " GET: " + docsGetErr.toString();
					}
					if(!pdfUploaded && workdriveFolderId != "")
					{
						try
						{
							pdfFileRetry = invokeurl
							[
								url :"https://www.zohoapis.com/crm/v2/Install_Price_Sheets/" + priceSheetId + "/Attachments/" + latestPdf.get("id")
								type :GET
								connection:"zcrm"
							];
							pdfFileRetry.setFileName(pdfFileName);
							pdfFileRetry.setParamName("uploaddoc");
							folderParams = Map();
							folderParams.put("folder_id",workdriveFolderId);
							retryResponse = invokeurl
							[
								url :documentsUrl
								type :POST
								parameters:folderParams
								files:pdfFileRetry
								connection:"zohoprojects"
							];
							try
							{
								if(retryResponse.toString() != "")
								{
									pdfUploadError = retryResponse.toString();
								}
							}
							catch(retryDumpErr)
							{
							}
							docsGetRetry = invokeurl
							[
								url :documentsUrl + "?range=100&category=all&folder_id=" + workdriveFolderId
								type :GET
								connection:"zohoprojects"
							];
							docRows = List();
							try
							{
								if(docsGetRetry.get("dataobj") != null)
								{
									docRows = docsGetRetry.get("dataobj");
								}
							}
							catch(retryDataobjErr)
							{
							}
							for each docRow in docRows
							{
								docName = "";
								try
								{
									docName = ifnull(docRow.get("res_name"),"").toString();
								}
								catch(retryResErr)
								{
								}
								if(docName.toLowerCase().contains(pdfFileNeedle) || (pdfNeedle != "" && docName.toLowerCase().contains(pdfNeedle)))
								{
									pdfUploaded = true;
								}
							}
							if(!pdfUploaded)
							{
								pdfUploadError = pdfUploadError + " GET names=";
								for each docRow in docRows
								{
									try
									{
										pdfUploadError = pdfUploadError + ifnull(docRow.get("res_name"),"").toString() + ",";
									}
									catch(retryNameDumpErr)
									{
									}
								}
							}
						}
						catch(priceSheetRetryErr)
						{
							pdfUploadError = pdfUploadError + " " + priceSheetRetryErr.toString();
						}
					}
					if(pdfUploaded)
					{
						pdfUploads.add("price_sheet");
					}
					else
					{
						if(folderLookupError != "")
						{
							pdfUploadError = pdfUploadError + " folders: " + folderLookupError;
						}
						warnings.add("Price sheet PDF upload failed. " + pdfUploadError);
					}
				}
				else
				{
					warnings.add("No PDF attachment was found on price sheet " + priceSheetName + ".");
				}
			}
			catch(priceSheetPdfErr)
			{
				warnings.add("Price sheet PDF upload failed: " + priceSheetPdfErr.toString());
			}
			}
		}
		else
		{
			if(crmQuoteNumber != "")
			{
				warnings.add("No Install Price Sheet matching SQ " + crmQuoteNumber + " was found.");
			}
			else
			{
				warnings.add("No Install Price Sheet matching the selected Sales Quote was found.");
			}
		}
	}
	catch(priceSheetErr)
	{
		warnings.add("Price sheet lookup failed.");
	}

	if(applyHoursOnly)
	{
	try
	{
		salesOrderId = "";
		soDigits = selectedSONumber.toString().replaceAll("[^0-9]","");
		booksOrgId = "";
		try
		{
			orgResp = invokeurl
			[
				url :"https://www.zohoapis.com/books/v3/organizations"
				type :GET
				connection:"books"
			];
			if(orgResp != null && orgResp.get("organizations") != null)
			{
				orgs = orgResp.get("organizations");
				if(orgs.size() > 0)
				{
					booksOrgId = ifnull(orgs.get(0).get("organization_id"),"").toString();
					for each  org in orgs
					{
						if(org.get("is_default_org") == true)
						{
							booksOrgId = ifnull(org.get("organization_id"),booksOrgId).toString();
							break;
						}
					}
				}
			}
		}
		catch(orgErr)
		{
			booksOrgId = "";
		}

		linkToSo = quote.get("Link_to_SO");
		try
		{
			if(linkToSo != null && linkToSo.get("id") != null)
			{
				salesOrderId = linkToSo.get("id").toString();
			}
		}
		catch(linkToSoErr)
		{
			salesOrderId = "";
		}

		if(booksOrgId != "" && salesOrderId != "")
		{
			try
			{
				booksSoCheck = invokeurl
				[
					url :"https://www.zohoapis.com/books/v3/salesorders/" + salesOrderId + "?organization_id=" + booksOrgId
					type :GET
					connection:"books"
				];
				if(booksSoCheck == null || booksSoCheck.get("salesorder") == null)
				{
					salesOrderId = "";
				}
			}
			catch(booksIdCheckErr)
			{
				salesOrderId = "";
			}
		}

		if(salesOrderId == "" && booksOrgId != "")
		{
			soNumberCandidates = List();
			if(selectedSONumber.toString() != "")
			{
				soNumberCandidates.add(selectedSONumber.toString());
			}
			if(soDigits != "")
			{
				if(soDigits != selectedSONumber.toString())
				{
					soNumberCandidates.add(soDigits);
				}
				soNumberCandidates.add("SO-" + soDigits);
			}
			for each  soNum in soNumberCandidates
			{
				if(salesOrderId == "" && soNum != "")
				{
					try
					{
						booksList = invokeurl
						[
							url :"https://www.zohoapis.com/books/v3/salesorders?organization_id=" + booksOrgId + "&salesorder_number=" + encodeUrl(soNum) + "&filter_by=Status.All"
							type :GET
							connection:"books"
						];
						if(booksList != null && booksList.get("salesorders") != null && booksList.get("salesorders").size() > 0)
						{
							salesOrderId = ifnull(booksList.get("salesorders").get(0).get("salesorder_id"),"").toString();
						}
					}
					catch(booksNumErr)
					{
					}
				}
			}
		}

		if(salesOrderId == "" && booksOrgId != "" && dealId != "")
		{
			try
			{
				booksByDeal = invokeurl
				[
					url :"https://www.zohoapis.com/books/v3/salesorders?organization_id=" + booksOrgId + "&zcrm_potential_id=" + dealId + "&filter_by=Status.All"
					type :GET
					connection:"books"
				];
				if(booksByDeal != null && booksByDeal.get("salesorders") != null)
				{
					for each  booksSo in booksByDeal.get("salesorders")
					{
						if(salesOrderId == "" && booksSo != null)
						{
							booksSoNumber = ifnull(booksSo.get("salesorder_number"),"").toString().replaceAll("[^0-9]","");
							if(soDigits == "" || booksSoNumber == soDigits)
							{
								salesOrderId = ifnull(booksSo.get("salesorder_id"),"").toString();
							}
						}
					}
				}
			}
			catch(booksDealErr)
			{
			}
		}

		if(salesOrderId == "" && booksOrgId != "" && soDigits != "")
		{
			try
			{
				booksSearch = invokeurl
				[
					url :"https://www.zohoapis.com/books/v3/salesorders?organization_id=" + booksOrgId + "&search_text=" + soDigits + "&filter_by=Status.All"
					type :GET
					connection:"books"
				];
				if(booksSearch != null && booksSearch.get("salesorders") != null)
				{
					for each  booksSo in booksSearch.get("salesorders")
					{
						if(salesOrderId == "" && booksSo != null)
						{
							booksSoNumber = ifnull(booksSo.get("salesorder_number"),"").toString().replaceAll("[^0-9]","");
							if(booksSoNumber == soDigits)
							{
								salesOrderId = ifnull(booksSo.get("salesorder_id"),"").toString();
							}
						}
					}
				}
			}
			catch(booksSearchErr)
			{
			}
		}

		if(salesOrderId != "" && booksOrgId != "")
		{
			hasSoPdf = false;
			try
			{
				soPdf = invokeurl
				[
					url :"https://www.zohoapis.com/books/v3/salesorders/" + salesOrderId + "?organization_id=" + booksOrgId + "&accept=pdf"
					type :GET
					connection:"books"
				];
				soPdf.setFileName("SO " + selectedSONumber + ".pdf");
				hasSoPdf = true;
			}
			catch(soPdfErr)
			{
				hasSoPdf = false;
			}

			if(hasSoPdf)
			{
				soUploaded = false;
				soUploadError = "";
				soFileName = "SO " + selectedSONumber + ".pdf";
				soMatchName = "SO " + selectedSONumber;
				soFileNeedle = soFileName.toLowerCase();
				soMatchNeedle = soMatchName.toLowerCase();
				soDocsGet = Map();
				soDocsGetRetry = Map();
				soLegacyResponse = Map();
				soPostRow = Map();
				try
				{
					soPdf.setParamName("uploaddoc");
					soLegacyResponse = invokeurl
					[
						url :documentsUrl
						type :POST
						files:soPdf
						connection:"zohoprojects"
					];
					soUploadError = "Documents POST returned empty.";
					try
					{
						soPostRow = soLegacyResponse.get(0);
					}
					catch(soPostListErr)
					{
						soPostRow = Map();
					}
					try
					{
						soUploadError = "POST name=" + ifnull(soPostRow.get("name"),"").toString() + " id=" + ifnull(soPostRow.get("id"),"").toString();
					}
					catch(soPostNameErr)
					{
						try
						{
							if(soLegacyResponse.toString() != "")
							{
								soUploadError = soLegacyResponse.toString();
							}
						}
						catch(soPostDumpErr)
						{
						}
					}
				}
				catch(soLegacyErr)
				{
					soUploadError = soLegacyErr.toString();
				}
				try
				{
					soDocsGet = invokeurl
					[
						url :documentsListUrl
						type :GET
						connection:"zohoprojects"
					];
					docRows = List();
					try
					{
						if(soDocsGet.get("dataobj") != null)
						{
							docRows = soDocsGet.get("dataobj");
						}
					}
					catch(soDataobjErr)
					{
					}
					for each docRow in docRows
					{
						docName = "";
						try
						{
							docName = ifnull(docRow.get("res_name"),"").toString();
						}
						catch(soResErr)
						{
						}
						if(docName.toLowerCase().contains(soFileNeedle) || docName.toLowerCase().contains(soMatchNeedle))
						{
							soUploaded = true;
						}
					}
					if(!soUploaded)
					{
						soUploadError = soUploadError + " GET names=";
						for each docRow in docRows
						{
							try
							{
								soUploadError = soUploadError + ifnull(docRow.get("res_name"),"").toString() + ",";
							}
							catch(soNameDumpErr)
							{
							}
						}
						try
						{
							soUploadError = soUploadError + " title=" + ifnull(soDocsGet.get("title"),"").toString();
						}
						catch(soTitleErr)
						{
						}
					}
				}
				catch(soDocsGetErr)
				{
					soUploadError = soUploadError + " GET: " + soDocsGetErr.toString();
				}
				if(!soUploaded && workdriveFolderId != "")
				{
					try
					{
						soPdfRetry = invokeurl
						[
							url :"https://www.zohoapis.com/books/v3/salesorders/" + salesOrderId + "?organization_id=" + booksOrgId + "&accept=pdf"
							type :GET
							connection:"books"
						];
						soPdfRetry.setFileName(soFileName);
						soPdfRetry.setParamName("uploaddoc");
						soFolderParams = Map();
						soFolderParams.put("folder_id",workdriveFolderId);
						soRetryResponse = invokeurl
						[
							url :documentsUrl
							type :POST
							parameters:soFolderParams
							files:soPdfRetry
							connection:"zohoprojects"
						];
						try
						{
							if(soRetryResponse.toString() != "")
							{
								soUploadError = soRetryResponse.toString();
							}
						}
						catch(soRetryDumpErr)
						{
						}
						soDocsGetRetry = invokeurl
						[
							url :documentsUrl + "?range=100&category=all&folder_id=" + workdriveFolderId
							type :GET
							connection:"zohoprojects"
						];
						docRows = List();
						try
						{
							if(soDocsGetRetry.get("dataobj") != null)
							{
								docRows = soDocsGetRetry.get("dataobj");
							}
						}
						catch(soRetryDataobjErr)
						{
						}
						for each docRow in docRows
						{
							docName = "";
							try
							{
								docName = ifnull(docRow.get("res_name"),"").toString();
							}
							catch(soRetryResErr)
							{
							}
							if(docName.toLowerCase().contains(soFileNeedle) || docName.toLowerCase().contains(soMatchNeedle))
							{
								soUploaded = true;
							}
						}
						if(!soUploaded)
						{
							soUploadError = soUploadError + " GET names=";
							for each docRow in docRows
							{
								try
								{
									soUploadError = soUploadError + ifnull(docRow.get("res_name"),"").toString() + ",";
								}
								catch(soRetryNameDumpErr)
								{
								}
							}
						}
					}
					catch(soRetryErr)
					{
						soUploadError = soUploadError + " " + soRetryErr.toString();
					}
				}
				if(soUploaded)
				{
					pdfUploads.add("sales_order");
				}
				else
				{
					if(folderLookupError != "")
					{
						soUploadError = soUploadError + " folders: " + folderLookupError;
					}
					warnings.add("Sales Order PDF upload failed. " + soUploadError);
				}
			}
			else
			{
				warnings.add("The Books Sales Order PDF could not be generated for SO " + selectedSONumber + ".");
			}
		}
		else
		{
			if(booksOrgId == "")
			{
				warnings.add("Could not load the Zoho Books organization, so the Sales Order PDF was not uploaded.");
			}
			else
			{
				warnings.add("No Zoho Books Sales Order was found for SO " + selectedSONumber + ".");
			}
		}
	}
	catch(soErr)
	{
		warnings.add("Sales Order PDF upload failed: " + soErr.toString());
	}
	}


	if(!applyHoursOnly)
	{
		if(priceSheet != null && priceSheet.get("id") != null)
		{
			hoursPending = true;
		}
	}

	if(applyHoursOnly)
	{
	try
	{
		if(priceSheet != null && priceSheet.get("id") != null)
		{
			hourFields = List();
			hourFields.add("Job_Review_Training_Hours");
			hourFields.add("Drive_Time_Hours");
			hourFields.add("Project_Management_Hours");
			hourFields.add("Warranty_Hours");
			hourFields.add("Tier_1_Cabling_Hours");
			hourFields.add("Tier_2_Cabling_Hours");
			hourFields.add("Tier_1_Video_Hours");
			hourFields.add("Tier_2_Video_Hours");
			hourFields.add("Tier_1_Audio_Hours");
			hourFields.add("Tier_2_Audio_Hours");
			hourFields.add("Tier_1_Component_Hours");
			hourFields.add("Tier_2_Component_Hours");
			hourFields.add("Programming_Hours");
			hourFields.add("T2_Programming_Hours");
			hourFields.add("Tier_3_Programming_Hours");

			psHours = Map();
			for each  hourField in hourFields
			{
				hourValue = 0.0;
				try
				{
					hourValue = ifnull(priceSheet.get(hourField),0).toDecimal();
				}
				catch(hourErr)
				{
					hourValue = 0.0;
				}
				if(hourValue < 0)
				{
					hourValue = 0.0;
				}
				psHours.put(hourField,hourValue);
			}

			t1Programming = psHours.get("Programming_Hours");
			t2Programming = psHours.get("T2_Programming_Hours");
			t3Programming = psHours.get("Tier_3_Programming_Hours");
			programmingParentHours = t1Programming + t2Programming + t3Programming;

			taskHours = Map();
			taskHours.put("Installation||Job Review",psHours.get("Job_Review_Training_Hours"));
			taskHours.put("Installation||Drive Time",psHours.get("Drive_Time_Hours"));
			taskHours.put("Installation||Cabling - T1",psHours.get("Tier_1_Cabling_Hours"));
			taskHours.put("Installation||Cabling - T2",psHours.get("Tier_2_Cabling_Hours"));
			taskHours.put("Installation||Video - T1",psHours.get("Tier_1_Video_Hours"));
			taskHours.put("Installation||Video - T2",psHours.get("Tier_2_Video_Hours"));
			taskHours.put("Installation||Audio - T1",psHours.get("Tier_1_Audio_Hours"));
			taskHours.put("Installation||Audio - T2",psHours.get("Tier_2_Audio_Hours"));
			taskHours.put("Installation||Component Management - T1",psHours.get("Tier_1_Component_Hours"));
			taskHours.put("Installation||Component Management - T2",psHours.get("Tier_2_Component_Hours"));
			taskHours.put("Administrative||Scheduling",psHours.get("Project_Management_Hours"));
			taskHours.put("Assembly||Programming",programmingParentHours);

			copiedTasks = List();
			try
			{
				taskResponse = invokeurl
				[
					url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/projects/" + projectId + "/tasks?per_page=200"
					type :GET
					connection:"zohoprojects"
				];
				if(taskResponse != null && taskResponse.get("tasks") != null)
				{
					copiedTasks = taskResponse.get("tasks");
				}
			}
			catch(taskPollErr)
			{
				copiedTasks = List();
			}
			taskCount = copiedTasks.size();
			if(taskCount >= templateTaskReadyCount)
			{
				hoursReady = true;
			}

			if(hoursReady)
			{
				hoursApplied = true;
				hoursPending = false;
				for each  copiedTask in copiedTasks
				{
					copiedName = ifnull(copiedTask.get("name"),"").toString().replaceAll("&amp;","&").trim();
					copiedListName = "";
					copiedList = copiedTask.get("tasklist");
					if(copiedList != null)
					{
						copiedListName = ifnull(copiedList.get("name"),"").toString();
					}
					hourKey = copiedListName + "||" + copiedName;
					mappedHours = taskHours.get(hourKey);
					if(mappedHours == null)
					{
						mappedHours = 0.0;
					}
					if(mappedHours > 0 && copiedTask.get("id") != null)
					{
						totalMinutes = (mappedHours * 60).round(0).toLong();
						if(totalMinutes < 1)
						{
							totalMinutes = 1;
						}
						hourPart = (totalMinutes / 60).toLong();
						minutePart = totalMinutes % 60;
						hourText = hourPart.toString();
						minuteText = minutePart.toString();
						if(hourText.length() < 2)
						{
							hourText = "0" + hourText;
						}
						if(minuteText.length() < 2)
						{
							minuteText = "0" + minuteText;
						}
						durationValue = hourText + ":" + minuteText;
						durationMap = Map();
						durationMap.put("type","hours");
						durationMap.put("value",durationValue);
						taskPayload = Map();
						taskPayload.put("duration",durationMap);
						taskPayload.put("hours_logged_at_last_progress",0);
						try
						{
							taskUpdateResponse = invokeurl
							[
								url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/projects/" + projectId + "/tasks/" + copiedTask.get("id")
								type :PATCH
								body:taskPayload.toString()
								headers:headersMap
								connection:"zohoprojects"
							];
							if(taskUpdateResponse != null && taskUpdateResponse.containsKey("error"))
							{
								durationOnly = Map();
								durationOnly.put("duration",durationMap);
								taskUpdateResponse = invokeurl
								[
									url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/projects/" + projectId + "/tasks/" + copiedTask.get("id")
									type :PATCH
									body:durationOnly.toString()
									headers:headersMap
									connection:"zohoprojects"
								];
							}
							if(taskUpdateResponse == null || taskUpdateResponse.containsKey("error"))
							{
								patchError = "Enter a valid hour format.";
								if(taskUpdateResponse != null && taskUpdateResponse.get("error") != null)
								{
									errorObj = taskUpdateResponse.get("error");
									if(errorObj.get("details") != null && errorObj.get("details").size() > 0)
									{
										patchError = ifnull(errorObj.get("details").get(0).get("message"),patchError);
									}
									else
									{
										patchError = ifnull(errorObj.get("title"),patchError);
									}
								}
								warnings.add("Could not apply " + mappedHours.toString() + " hours to task " + copiedName + ". " + patchError);
							}
							else
							{
								tasksUpdated = tasksUpdated + 1;
							}
						}
						catch(taskUpdateErr)
						{
							warnings.add("Could not apply " + mappedHours.toString() + " hours to task " + copiedName + ". " + taskUpdateErr.toString());
						}
					}
				}

				try
				{
					creatorSheetId = "";
					creatorFetchError = "";
					creatorSearch = Map();
					creatorResp = Map();
					creatorData = Map();
					searchSheet = Map();
					searchRow = Map();
					foundCreatorId = "";
					searchCode = "";
					creatorGetParams = Map();
					creatorGetParams.put("field_config","all");
					soldLookups = List();
					if(priceSheetId != "")
					{
						creatorSearchParams = Map();
						creatorSearchParams.put("criteria","CRM_Install_Price_Sheet_ID == \"" + priceSheetId + "\"");
						creatorSearchParams.put("field_config","all");
						creatorSearchParams.put("max_records","200");
						try
						{
							creatorResp = invokeurl
							[
								url :"https://www.zohoapis.com/creator/v2.1/data/tvspro/application-by-chris/report/All_Price_Sheets"
								type :GET
								parameters:creatorSearchParams
								connection:"creator_connection"
							];
						}
						catch(creatorSearchErr)
						{
							creatorFetchError = creatorSearchErr.toString();
						}
						if(creatorSheetId == "" && priceSheetName != "")
						{
							try
							{
								searchCode = ifnull(creatorResp.get("code"),"").toString();
								if(searchCode == "3100")
								{
									creatorSearchParams.put("criteria","Project_Name == \"" + priceSheetName + "\"");
									creatorResp = invokeurl
									[
										url :"https://www.zohoapis.com/creator/v2.1/data/tvspro/application-by-chris/report/All_Price_Sheets"
										type :GET
										parameters:creatorSearchParams
										connection:"creator_connection"
									];
								}
							}
							catch(creatorNameSearchErr)
							{
							}
						}
						try
						{
							if(creatorResp.get("data") != null)
							{
								creatorData = creatorResp.get("data");
							}
						}
						catch(unwrapCreatorSearchErr)
						{
						}
						try
						{
							foundCreatorId = ifnull(creatorData.get("ID"),"").toString();
							if(creatorData.get("Line_Item_Lookup") != null)
							{
								soldLookups = creatorData.get("Line_Item_Lookup");
							}
						}
						catch(creatorSearchIdErr)
						{
							foundCreatorId = "";
						}
						if(foundCreatorId == "")
						{
							try
							{
								searchRow = creatorData.get(0);
							}
							catch(creatorSearchRowErr)
							{
								searchRow = Map();
							}
							try
							{
								foundCreatorId = ifnull(searchRow.get("ID"),"").toString();
							}
							catch(creatorRowIdErr)
							{
							}
							try
							{
								if(searchRow.get("Line_Item_Lookup") != null)
								{
									soldLookups = searchRow.get("Line_Item_Lookup");
								}
							}
							catch(creatorRowLookupErr)
							{
							}
						}
						if(foundCreatorId != "" && foundCreatorId != priceSheetId)
						{
							creatorSheetId = foundCreatorId;
						}
						if(soldLookups.size() <= 0 && creatorSheetId != "")
						{
							try
							{
								creatorResp = invokeurl
								[
									url :"https://www.zohoapis.com/creator/v2.1/data/tvspro/application-by-chris/report/All_Price_Sheets/" + creatorSheetId
									type :GET
									parameters:creatorGetParams
									connection:"creator_connection"
								];
								try
								{
									if(creatorResp.get("data") != null)
									{
										creatorData = creatorResp.get("data");
									}
								}
								catch(creatorDataErr)
								{
									creatorFetchError = creatorDataErr.toString();
								}
								try
								{
									if(creatorData.get("Line_Item_Lookup") != null)
									{
										soldLookups = creatorData.get("Line_Item_Lookup");
									}
								}
								catch(creatorLookupErr)
								{
								}
							}
							catch(creatorGetErr)
							{
								creatorFetchError = creatorGetErr.toString();
							}
						}
						if(soldLookups.size() <= 0 && creatorFetchError == "")
						{
							try
							{
								creatorFetchError = creatorResp.toString();
							}
							catch(creatorSearchDumpErr)
							{
								creatorFetchError = "";
							}
							if(creatorFetchError == "")
							{
								try
								{
									creatorFetchError = "code=" + ifnull(creatorResp.get("code"),"").toString() + " message=" + ifnull(creatorResp.get("message"),"").toString() + " Confirm creator_connection is attached to this function.";
								}
								catch(creatorSearchCodeErr)
								{
									creatorFetchError = "Creator REST search returned empty. Confirm creator_connection is attached to this function.";
								}
							}
						}
					}
					if(soldLookups.size() <= 0)
					{
						if(creatorSheetId == "" && creatorFetchError == "" && priceSheetId != "")
						{
							creatorFetchError = "No Creator price sheet matched CRM_Install_Price_Sheet_ID " + priceSheetId + ".";
						}
						if(creatorSheetId != "" || priceSheetId != "")
						{
							if(creatorFetchError != "")
							{
								warnings.add("Creator sold lines were not returned for this price sheet. Task hours were still applied. API: " + creatorFetchError);
							}
							else
							{
								warnings.add("Creator sold lines were not returned for this price sheet. Task hours were still applied.");
							}
						}
					}
					else
					{
						taskByRoute = Map();
						for each  copiedTask in copiedTasks
						{
							routeName = ifnull(copiedTask.get("name"),"").toString().replaceAll("&amp;","&").trim();
							routeList = "";
							copiedList = copiedTask.get("tasklist");
							if(copiedList != null)
							{
								routeList = ifnull(copiedList.get("name"),"").toString();
							}
							taskByRoute.put(routeList + "||" + routeName,copiedTask);
							taskByRoute.put(routeName,copiedTask);
						}
						catalogById = Map();
						try
						{
							catalogRows = zoho.creator.getRecords("tvspro","application-by-chris","All_Line_Items","Hours >= 0",1,200,"creator_connection");
							try
							{
								if(catalogRows.get("data") != null)
								{
									catalogRows = catalogRows.get("data");
								}
							}
							catch(catalogRowsUnwrapErr)
							{
							}
							if(catalogRows != null)
							{
								for each  catalogRow in catalogRows
								{
									try
									{
										catalogById.put(ifnull(catalogRow.get("ID"),"").toString(),catalogRow);
									}
									catch(catalogRowIdErr)
									{
									}
								}
							}
						}
						catch(catalogPageErr)
						{
						}
						soldBuckets = Map();
						bucketKeys = List();
						statusRef = Map();
						soldRow = Map();
						lookupData = Map();
						qtyResp = Map();
						catalogRef = Map();
						for each  soldLookup in soldLookups
						{
							soldRow = soldLookup;
							lookupId = "";
							try
							{
								lookupId = ifnull(soldLookup.get("ID"),"").toString();
							}
							catch(lookupIdErr)
							{
								lookupId = "";
							}
							if(lookupId != "")
							{
								try
								{
									qtyResp = invokeurl
									[
										url :"https://www.zohoapis.com/creator/v2.1/data/tvspro/application-by-chris/report/All_Line_Item_Lookups/" + lookupId
										type :GET
										parameters:creatorGetParams
										connection:"creator_connection"
									];
									lookupData = Map();
									try
									{
										if(qtyResp.get("data") != null)
										{
											lookupData = qtyResp.get("data");
										}
									}
									catch(qtyDataErr)
									{
									}
									try
									{
										if(lookupData.get("ID") != null)
										{
											soldRow = lookupData;
										}
									}
									catch(qtyIdErr)
									{
									}
								}
								catch(qtyApiErr)
								{
								}
							}
							catalogRef = Map();
							try
							{
								catalogRef = soldRow.get("Install_Line_Items_Hours_Cost");
							}
							catch(catalogRefErr)
							{
								catalogRef = Map();
							}
							lineName = "";
							catalogId = "";
							try
							{
								lineName = ifnull(catalogRef.get("Install_Line_Name"),"").toString();
								catalogId = ifnull(catalogRef.get("ID"),"").toString();
							}
							catch(catalogFieldsErr)
							{
							}
							if(lineName != "")
							{
								hoursEach = 0.0;
								try
								{
									hoursEach = ifnull(catalogRef.get("Hours"),0).toDecimal();
								}
								catch(hoursEachErr)
								{
									hoursEach = 0.0;
								}
								qtySold = 1.0;
								try
								{
									if(soldRow.get("Quantity") != null)
									{
										qtySold = ifnull(soldRow.get("Quantity"),1).toDecimal();
									}
								}
								catch(qtyErr)
								{
									qtySold = 1.0;
								}
								if(lineName != "" && hoursEach > 0 && qtySold > 0)
								{
									category = "";
									tier = "";
									catalogRow = catalogById.get(catalogId);
									if(catalogRow == null && catalogId != "")
									{
										try
										{
											catalogLookup = zoho.creator.getRecords("tvspro","application-by-chris","All_Line_Items","ID == " + catalogId,1,1,"creator_connection");
											try
											{
												if(catalogLookup.get("data") != null)
												{
													catalogLookup = catalogLookup.get("data");
												}
											}
											catch(catalogUnwrapErr)
											{
											}
											try
											{
												if(catalogLookup.get("ID") != null)
												{
													catalogRow = catalogLookup;
												}
											}
											catch(catalogMapErr)
											{
											}
											if(catalogRow == null)
											{
												try
												{
													catalogRow = catalogLookup.get(0);
												}
												catch(catalogListErr)
												{
												}
											}
											if(catalogRow != null)
											{
												catalogById.put(catalogId,catalogRow);
											}
										}
										catch(catalogErr)
										{
										}
									}
									if(catalogRow != null)
									{
										try
										{
											category = ifnull(catalogRow.get("Task_Category"),"").toString();
											tier = ifnull(catalogRow.get("Tier"),"").toString();
										}
										catch(catalogFieldsReadErr)
										{
										}
									}
									targetTask = null;
									if(category == "Programming")
									{
										targetTask = taskByRoute.get("Assembly||Programming");
										if(targetTask == null)
										{
											targetTask = taskByRoute.get("Programming");
										}
									}
									else
									{
										categoryName = category;
										if(category == "Component")
										{
											categoryName = "Component Management";
										}
										tierSuffix = "";
										if(tier == "2" || tier == "3")
										{
											tierSuffix = " - T2";
										}
										else if(tier == "1")
										{
											tierSuffix = " - T1";
										}
										if(categoryName != "" && tierSuffix != "")
										{
											targetTask = taskByRoute.get("Installation||" + categoryName + tierSuffix);
											if(targetTask == null)
											{
												targetTask = taskByRoute.get(categoryName + tierSuffix);
											}
										}
									}
									if(targetTask != null && targetTask.get("id") != null)
									{
										bucketKey = targetTask.get("id").toString() + "||" + lineName;
										bucket = soldBuckets.get(bucketKey);
										if(bucket == null)
										{
											bucket = Map();
											bucket.put("name",lineName);
											bucket.put("task_id",targetTask.get("id").toString());
											bucket.put("catalog_id",catalogId);
											bucket.put("hours_each",hoursEach);
											bucket.put("sold_qty",qtySold);
											bucketKeys.add(bucketKey);
										}
										else
										{
											bucket.put("sold_qty",bucket.get("sold_qty") + qtySold);
										}
										soldBuckets.put(bucketKey,bucket);
									}
								}
							}
						}
						for each  bucketKey in bucketKeys
						{
							bucket = soldBuckets.get(bucketKey);
							allocatedHours = bucket.get("hours_each") * bucket.get("sold_qty");
							linePayload = Map();
							linePayload.put("name",bucket.get("name"));
							projectRef = Map();
							projectRef.put("id",projectId);
							linePayload.put("project",projectRef);
							layoutRef = Map();
							layoutRef.put("id","1684307000018866202");
							linePayload.put("layout",layoutRef);
							linePayload.put("qty_done",0);
							linePayload.put("sold_qty",bucket.get("sold_qty"));
							linePayload.put("hours_each",bucket.get("hours_each"));
							linePayload.put("allocated_hours",allocatedHours);
							linePayload.put("related_task_id",bucket.get("task_id"));
							linePayload.put("catalog_line_id",bucket.get("catalog_id"));
							statusRef = Map();
							statusRef.put("id","1684307000018866228");
							linePayload.put("status",statusRef);
							try
							{
								lineCreate = invokeurl
								[
									url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/module/install_line/entities"
									type :POST
									body:linePayload.toString()
									headers:headersMap
									connection:"zohoprojects"
								];
								if(lineCreate != null && lineCreate.containsKey("error"))
								{
									lineCreate = invokeurl
									[
										url :"https://projectsapi.zoho.com/api/v3/portal/" + portalId + "/install_line/entities"
										type :POST
										body:linePayload.toString()
										headers:headersMap
										connection:"zohoprojects"
									];
								}
								if(lineCreate != null && !lineCreate.containsKey("error"))
								{
									lineItemsCreated = lineItemsCreated + 1;
								}
								else if(lineCreate != null)
								{
									warnings.add("Could not create install line " + bucket.get("name").toString() + ". " + lineCreate.toString());
								}
								else
								{
									warnings.add("Could not create install line " + bucket.get("name").toString() + ". POST returned empty.");
								}
							}
							catch(lineCreateErr)
							{
								warnings.add("Could not create install line " + bucket.get("name").toString() + ". " + lineCreateErr.toString());
							}
						}
						if(bucketKeys.size() > 0 && lineItemsCreated <= 0)
						{
							warnings.add("Sold install lines were found but could not be written to the Install Lines module.");
						}
					}
				}
				catch(soldLinesErr)
				{
					warnings.add("Sold install lines could not be written to the Install Lines module. " + soldLinesErr.toString());
				}
			}
			else
			{
				hoursPending = true;
			}
		}
	}
	catch(taskHoursErr)
	{
		warnings.add("Price sheet hours could not be applied to project tasks.");
	}
	}

	if(applyHoursOnly)
	{
		successMessage = "Price sheet hours were applied to project tasks.";
		if(hoursPending)
		{
			successMessage = "Template tasks are not ready yet.";
		}
		if(tasksUpdated > 0)
		{
			successMessage = "Applied price sheet hours to " + tasksUpdated.toString() + " task(s).";
		}
		if(lineItemsCreated > 0)
		{
			successMessage = successMessage + " Created " + lineItemsCreated.toString() + " install line(s).";
		}
		if(pdfUploads.size() > 0)
		{
			successMessage = successMessage + " Uploaded " + pdfUploads.size().toString() + " PDF(s) to project documents.";
		}
	}
	else
	{
	successMessage = "Private project created from template and linked successfully.";
	if(pdfUploads.size() > 0)
	{
		successMessage = successMessage + " Uploaded " + pdfUploads.size().toString() + " PDF(s) to project documents.";
	}
	}

	result = Map();
	result.put("success",true);
	result.put("message",successMessage);
	result.put("project_id",projectId);
	result.put("project_key",projectKey);
	result.put("project_name",projectName);
	result.put("task_count_at_verification",taskCount);
	result.put("task_count",taskCount);
	result.put("ready_count",templateTaskReadyCount);
	result.put("hours_pending",hoursPending);
	result.put("hours_ready",hoursReady);
	result.put("hours_applied",hoursApplied);
	result.put("tasks_updated",tasksUpdated);
	result.put("line_items_created",lineItemsCreated);
	result.put("pdf_uploads",pdfUploads);
	result.put("warnings",warnings);
	result.put("price_sheet_id",priceSheetId);
	result.put("price_sheet_name",priceSheetName);

	return result.toString();
}
catch(e)
{
	result = Map();
	result.put("success",false);
	result.put(
		"message",
		"Project creation failed: " + e.toString()
	);
	return result.toString();
}

finalResult = Map();
finalResult.put("success",false);
finalResult.put("message","Project creation failed.");
return finalResult.toString();
}